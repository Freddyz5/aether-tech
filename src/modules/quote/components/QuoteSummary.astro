---
/*
  Cierre del cotizador: la barra de validez, las acciones (imprimir/guardar)
  y la nota de cronograma, más la barra de total que queda fija abajo. En el
  diseño de origen la barra de total no llevaba data-noprint y por eso se
  repetía en cada hoja al imprimir — se lo agrego aquí porque es un defecto
  de impresión, no una decisión de estilo.
*/
interface Props {
  totalLabel: string;
  print: string;
  save: string;
  scheduleNote: string;
  validityTitle: string;
  validityValue: string;
}

const { totalLabel, print, save, scheduleNote, validityTitle, validityValue } = Astro.props;
---

<div class="bp-totalbar" data-noprint="1">
  <div class="bp-totalbar__inner">
    <div>
      <p class="bp-totalbar__label">{totalLabel}</p>
      <p class="bp-totalbar__amount" data-total-amount aria-live="polite"></p>
    </div>
    <span class="bp-totalbar__spacer"></span>
    <p class="bp-totalbar__count" data-total-count></p>
  </div>
</div>

<div class="bp-validity">
  <span class="bp-validity__title">{validityTitle}</span>
  <span class="bp-validity__rule" aria-hidden="true"></span>
  <span class="bp-validity__value">{validityValue}</span>
</div>

<div class="bp-actions" data-noprint="1">
  <button type="button" class="bp-action" data-print>{print}</button>
  <button type="button" class="bp-action bp-action--accent" data-save>
    <span data-save-label>{save}</span>
  </button>
</div>

<p class="bp-schedule">{scheduleNote}</p>
