---
/*
  Composición del cotizador — puerto de "Cotizacion Aether Tech.dc.html"
  (Claude Design). Todo el marcado sale del servidor, así que la página se
  lee entera sin JavaScript; lo que el controlador añade son los estados,
  las cifras y el enlace. Los datos viajan al cliente en un
  <script type="application/json"> para no serializar un objeto grande con
  define:vars.

  A diferencia de la versión anterior, aquí NO hay una sección aparte
  "sólo para pantalla" y un documento aparte "sólo para imprimir": el diseño
  de origen imprime la misma vista, y sólo oculta con [data-noprint] la
  cabecera y los botones de acción (ver CommercialLayout.astro y
  QuoteSummary.astro).
*/
import QuoteHeader from './components/QuoteHeader.astro';
import QuoteToggleItem from './components/QuoteToggleItem.astro';
import QuoteCounterItem from './components/QuoteCounterItem.astro';
import QuoteChoiceItem from './components/QuoteChoiceItem.astro';
import QuoteConditions from './components/QuoteConditions.astro';
import QuoteSummary from './components/QuoteSummary.astro';
import { indexQuote } from './core/quote';
import type { QuoteData } from './core/types';
import './styles/quote.css';

interface Props {
  data: QuoteData;
  backHref: string;
}

const { data, backHref } = Astro.props;
const { ui, settings, phases } = data;

/* El nombre legible de cada requisito, para el cartel «Necesita: …». */
const { nameById } = indexQuote(data);
const requiresName = (id?: string) => (id ? nameById.get(id) ?? id : '');

const validityValue = `${settings.validityDays} ${ui.validitySuffix}`;
---

<QuoteHeader back={ui.back} backHref={backHref} />

<main class="bp-quote" id="quote">
  <section class="bp-hero">
    <span class="bp-hero__corner bp-hero__corner--tl" aria-hidden="true"></span>
    <span class="bp-hero__corner bp-hero__corner--tr" aria-hidden="true"></span>
    <span class="bp-hero__corner bp-hero__corner--bl" aria-hidden="true"></span>
    <span class="bp-hero__corner bp-hero__corner--br" aria-hidden="true"></span>
    <span class="bp-hero__rule-v" aria-hidden="true"></span>
    <span class="bp-hero__rule-h" aria-hidden="true"></span>
    <span class="bp-hero__node" aria-hidden="true"></span>
    <span class="bp-hero__box" aria-hidden="true"></span>

    <p class="bp-hero__eyebrow">
      <span class="bp-hero__eyebrow-rule" aria-hidden="true"></span>
      <span class="bp-hero__eyebrow-text">{ui.eyebrow}</span>
    </p>
    <h1 class="bp-hero__title">{settings.subject}</h1>
    <p class="bp-hero__lead">{ui.intro}</p>
  </section>

  <p class="bp-readonly" data-readonly-notice hidden>{ui.readonlyNotice}</p>

  {
    phases.map((phase) => (
      <section class="bp-phase">
        <div class="bp-phase__head">
          <span class="bp-phase__dot" aria-hidden="true" />
          <span class="bp-phase__name">{phase.name}</span>
          <span class="bp-phase__rule" aria-hidden="true" />
        </div>
        {phase.note && <p class="bp-phase__note">{phase.note}</p>}

        <div class="bp-phase__items">
          {phase.items.map((item) =>
            item.kind === 'toggle' ? (
              <QuoteToggleItem
                item={item}
                requiresLabel={ui.requires}
                requiresName={requiresName(item.requires)}
              />
            ) : item.kind === 'counter' ? (
              <QuoteCounterItem
                item={item}
                requiresLabel={ui.requires}
                requiresName={requiresName(item.requires)}
                addLabel={ui.addUnit}
                removeLabel={ui.removeUnit}
              />
            ) : (
              <QuoteChoiceItem
                item={item}
                requiresLabel={ui.requires}
                requiresName={requiresName(item.requires)}
                chooseOne={ui.chooseOne}
                recommended={ui.recommended}
              />
            ),
          )}
        </div>
      </section>
    ))
  }

  <div class="bp-conditions">
    <QuoteConditions title={ui.recurringTitle} points={data.recurringCosts} />
    <QuoteConditions title={ui.notIncludedTitle} points={data.notIncluded} />
  </div>

  <QuoteSummary
    totalLabel={ui.totalLabel}
    print={ui.print}
    save={ui.save}
    scheduleNote={ui.scheduleNote}
    validityTitle={ui.validityTitle}
    validityValue={validityValue}
  />

  <script type="application/json" data-quote-data set:html={JSON.stringify(data)} is:inline />
</main>

<script>
  import { mountQuote } from './core/controller';
  import { isReadonly } from './core/url';
  import type { QuoteData } from './core/types';

  const root = document.getElementById('quote');
  const payload = root?.querySelector('[data-quote-data]');

  if (root && payload?.textContent) {
    const data = JSON.parse(payload.textContent) as QuoteData;

    /* El aviso sólo aparece cuando el enlace realmente trae el modo. */
    if (isReadonly(new URLSearchParams(location.search))) {
      const notice = root.querySelector<HTMLElement>('[data-readonly-notice]');
      if (notice) notice.hidden = false;
    }

    mountQuote(root, data, 'es');
  }
</script>
