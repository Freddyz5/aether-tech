---
/*
  Cotizador por piezas. NO está enlazado desde ninguna parte a propósito: es la
  herramienta que se abre en la reunión, no una página pública del sitio — por
  eso además la raíz del sitio redirige aquí en astro.config.mjs mientras no
  exista una landing pública de Aether Tech que ocupe esa raíz.

  `?readonly=1` congela la interacción y deja el presupuesto como quedó en el
  enlace, que es la puerta prevista para abrirlo al público sin rehacerlo.

  Contenido y tarifas viven en src/constants/quote.json; aquí no hay cifras.
  Ese archivo ya está adaptado a Aether Tech: landing de 4 secciones con el
  llamado a la acción como emprendimiento social dentro, catálogo de kits con
  pedido por WhatsApp y la elección de cómo se administra ese catálogo (panel,
  planilla o fijo), más servicios. Los prototipos del club no son una galería
  aparte: entran al mismo catálogo con su propia etiqueta y ficha sin precio.
  Esa pieza y la de auspiciantes quedan apagadas por defecto: se cotizan, pero
  no salieron del pedido del cliente.
*/
import CommercialLayout from '../shared/layout/CommercialLayout.astro';
import QuotePage from '../modules/quote/QuotePage.astro';
import quote from '../constants/quote.json';
import type { QuoteData } from '../modules/quote/core/types';

const data = quote as unknown as QuoteData;
const BASE_URL = import.meta.env.BASE_URL;
const url = new URL(`${BASE_URL}quote`, Astro.site ?? Astro.url.origin).href;

/*
  «Volver» no puede apuntar a "/" todavía: la raíz redirige a /quote (ver
  astro.config.mjs), así que sería un ciclo tonto en vez de una salida. Hasta
  que exista una landing propia, manda al Facebook de Aether Tech — su
  presencia pública real hoy. Cambiar a `${BASE_URL}/` (o a /services) en
  cuanto haya un sitio que la reciba.
*/
const backHref = 'https://www.facebook.com/p/AetherTech-61571211006887/';
---

<CommercialLayout title={data.meta.title} description={data.meta.description} url={url}>
  <QuotePage data={data} backHref={backHref} />
</CommercialLayout>
